{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["ALTIVOLA_DB_*", "API_URL", "VERSION"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {},
    "test": {
      "cache": false
    }
  }
}
