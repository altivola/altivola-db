{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Jakarta",
  "schedule": ["before 6am on monday"],
  "packageRules": [
    {
      "description": "Auto merge minor and patch updates of stable packages when CI is green",
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^v?0\\./",
      "automerge": true
    },
    {
      "matchPackageNames": ["/^@orpc//"],
      "groupName": "orpc"
    },
    {
      "description": "Keep the CodeMirror packages together",
      "matchPackageNames": ["/^@codemirror//", "/^@lezer//"],
      "groupName": "codemirror"
    },
    {
      "description": "Keep the testcontainers modules together",
      "matchPackageNames": ["/^@testcontainers//", "testcontainers"],
      "groupName": "testcontainers"
    }
  ]
}
