{
  "name": "@app/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ALTIVOLA_DB_TOKEN=dev-token tsx watch src/main.ts serve --no-browser --addr 127.0.0.1:7800",
    "cli": "tsx src/main.ts",
    "build": "tsx scripts/build.ts",
    "start": "node --enable-source-maps dist/altivola-db.js",
    "openapi": "tsx scripts/openapi.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@app/api": "workspace:*",
    "@app/core": "workspace:*",
    "@hono/node-server": "^2.1.9",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@orpc/openapi": "^1.16.2",
    "@orpc/server": "^1.16.2",
    "@orpc/zod": "^1.16.2",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0",
    "@app/web": "workspace:*"
  }
}
